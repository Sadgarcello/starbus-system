# Khawaja Club
# Copy to .env and fill from Supabase → Project Settings → API

VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# Web Push — public key (browser + phone subscribe)
VITE_VAPID_PUBLIC_KEY=your_vapid_public_key_here

# Web Push — server only (Vercel API route /api/send-push; never expose in frontend)
VAPID_PRIVATE_KEY=your_vapid_private_key_here
VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_SUBJECT=mailto:admin@khawajaclub.test
PUSH_DISPATCH_SECRET=long_random_secret_same_as_supabase_sql
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# Khawaja AI Coach — server only (Vercel /api/evaluate-text; never expose in frontend)
# Free tier: https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# After adding GEMINI_API_KEY on Vercel, run migration 0017_ai_text_evaluations.sql in Supabase SQL Editor.
